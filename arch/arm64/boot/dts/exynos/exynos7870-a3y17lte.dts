// SPDX-License-Identifier: GPL-2.0
/*
 * Samsung Galaxy A3 (2017) (a3y17lte) device tree source
 *
 * Based on exynos7870-j5y17lte.dts. Board data cross-checked against the
 * vendor a3y17lte rev02/rev03 device trees.
 */

/dts-v1/;
#include "exynos7870.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/interrupt-controller/irq.h>

/ {
	model = "Samsung Galaxy A3 (2017)";
	compatible = "samsung,a3y17lte", "samsung,exynos7870";
	chassis-type = "handset";

	aliases {
		mmc0 = &mmc0;
		mmc1 = &mmc1;
		mmc2 = &mmc2;
		serial0 = &serial0;
		serial1 = &serial1;
		serial2 = &serial2;
	};

	battery: battery {
		compatible = "simple-battery";
		device-chemistry = "lithium-ion";
		charge-full-design-microamp-hours = <2350000>;
		voltage-max-design-microvolt = <4350000>;
		constant-charge-voltage-max-microvolt = <4350000>;
		constant-charge-current-max-microamp = <2100000>;
		charge-term-current-microamp = <245000>;
		operating-range-celsius = <0 50>;
	};

	chosen {
		ranges;
		#address-cells = <2>;
		#size-cells = <1>;

		stdout-path = &serial2;

		/* Left running by S-Boot (s3cfb.bootloaderfb=0x67000000) */
		framebuffer@67000000 {
			compatible = "simple-framebuffer";
			reg = <0x0 0x67000000 (720 * 1280 * 4)>;
			width = <720>;
			height = <1280>;
			stride = <(720 * 4)>;
			format = "a8r8g8b8";
		};
	};

	/* 32.768 kHz sleep clock for the QCA9377, from the S2MPU05 (always running) */
	bt_sleep_clk: clock-32k {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <32768>;
		clock-output-names = "bt_sleep_clk";
	};

	gpio-hall-effect-sensor {
		compatible = "gpio-keys";
		label = "GPIO Hall Effect Sensor";

		pinctrl-0 = <&hall_irq>;
		pinctrl-names = "default";

		event-hall-effect-sensor {
			label = "Hall Effect Sensor";
			gpios = <&gpa2 3 GPIO_ACTIVE_LOW>;
			wakeup-source;
			linux,input-type = <EV_SW>;
			linux,code = <SW_LID>;
			linux,can-disable;
		};
	};

	gpio-keys {
		compatible = "gpio-keys";
		pinctrl-0 = <&key_power &key_voldown &key_volup>;
		pinctrl-names = "default";

		key-home {
			interrupt-parent = <&gpa1>;
			label = "gpio-keys: KEY_HOMEPAGE";
			gpios = <&gpa1 7 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_HOMEPAGE>;
			wakeup-source;
		};

		key-power {
			interrupt-parent = <&gpa0>;
			label = "gpio-keys: KEY_POWER";
			gpios = <&gpa0 0 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_POWER>;
			wakeup-source;
		};

		key-voldown {
			interrupt-parent = <&gpa2>;
			label = "gpio-keys: KEY_VOLUMEDOWN";
			gpios = <&gpa2 1 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_VOLUMEDOWN>;
		};

		key-volup {
			interrupt-parent = <&gpa2>;
			label = "gpio-keys: KEY_VOLUMEUP";
			gpios = <&gpa2 0 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_VOLUMEUP>;
		};
	};

	/* Touch keys: the vendor kernel bit-bangs this bus, hardware i2c2 gets no ACK */
	i2c-touchkey {
		compatible = "i2c-gpio";
		sda-gpios = <&gpc8 0 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		scl-gpios = <&gpc8 1 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		i2c-gpio,delay-us = <2>;
		#address-cells = <1>;
		#size-cells = <0>;

		touchkey@20 {
			compatible = "abov,a96t316-touchkey";
			reg = <0x20>;

			interrupt-parent = <&gpa1>;
			interrupts = <4 IRQ_TYPE_EDGE_FALLING>;

			pinctrl-0 = <&touchkey_irq>;
			pinctrl-names = "default";

			vcc-supply = <&vdd_fixed_touch>;
			vdd-supply = <&vdd_ldo33>;

			linux,keycodes = <KEY_APPSELECT KEY_BACK>;
		};
	};

	memory@40000000 {
		device_type = "memory";
		reg = <0x0 0x40000000 0x3e400000>,
		      <0x0 0x80000000 0x40000000>;
	};

	pwrseq_mmc1: pwrseq-mmc1 {
		compatible = "mmc-pwrseq-simple";
		reset-gpios = <&gpd3 6 GPIO_ACTIVE_LOW>;
	};

	vdd_fixed_mmc2: regulator-fixed-mmc2 {
		compatible = "regulator-fixed";
		regulator-name = "vdd_fixed_mmc2";
		regulator-max-microvolt = <2800000>;
		regulator-min-microvolt = <2800000>;

		gpio = <&gpc0 0 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};

	/* Touchscreen I/O 2.8 V, enabled by the bootloader */
	vdd_fixed_touch: regulator-fixed-touch {
		compatible = "regulator-fixed";
		regulator-name = "vdd_fixed_touch";
		regulator-max-microvolt = <2800000>;
		regulator-min-microvolt = <2800000>;

		gpio = <&gpd1 6 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-boot-on;
	};

	/*
	 * QCA9377 Wi-Fi/BT power switch. Shared by both functions and the
	 * Bluetooth driver has no supply for it, so it is kept on.
	 */
	vdd_fixed_wlan: regulator-fixed-wlan {
		compatible = "regulator-fixed";
		regulator-name = "vdd_fixed_wlan";

		gpio = <&gpf3 0 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		startup-delay-us = <4000>;
		regulator-always-on;
	};

	reserved-memory {
		ranges;
		#address-cells = <2>;
		#size-cells = <1>;

		ramoops@46e00000 {
			compatible = "ramoops";
			reg = <0x0 0x46e00000 0x8000>;
			console-size = <0x4000>;
			pmsg-size = <0x4000>;
		};

		cont_splash_mem: framebuffer@67000000 {
			reg = <0x0 0x67000000 (720 * 1280 * 4)>;
			iommu-addresses = <&decon 0x67000000 (720 * 1280 * 4)>;
			no-map;
		};
	};

	battery_thermistor: thermal-sensor-battery {
		compatible = "generic-adc-thermal";
		#io-channel-cells = <0>;
		#thermal-sensor-cells = <0>;
		io-channels = <&adc 1>;
		io-channel-names = "sensor-channel";
		/*
		 * Vendor table converted from ADC codes to millivolts with the
		 * ADC scale (1.8 V / 4095); the voltage falls as temperature rises.
		 */
		temperature-lookup-table = <(-20000) 1589
					    (-15000) 1547
					    (-10000) 1486
					    (-5000) 1441
					    0 1368
					    5000 1287
					    10000 1193
					    15000 1099
					    20000 993
					    25000 892
					    27000 878
					    29000 838
					    32000 781
					    35000 723
					    40000 606
					    45000 527
					    50000 455
					    55000 388
					    60000 323
					    65000 284
					    70000 241
					    75000 212
					    80000 177
					    85000 153
					    90000 127>;
	};

	thermal-zones {
		battery-thermal {
			polling-delay-passive = <0>;
			polling-delay = <5000>;
			thermal-sensors = <&battery_thermistor>;
		};
	};

	vibrator {
		compatible = "regulator-haptic";
		haptic-supply = <&vdd_ldo32>;
		min-microvolt = <3325000>;
		max-microvolt = <3325000>;
	};
};

&adc {
	vdd-supply = <&vdd_ldo3>;
	status = "okay";
};

&cpu0 {
	cpu-supply = <&vdd_buck1>;
};

&cpu1 {
	cpu-supply = <&vdd_buck1>;
};

&cpu2 {
	cpu-supply = <&vdd_buck1>;
};

&cpu3 {
	cpu-supply = <&vdd_buck1>;
};

&cpu4 {
	cpu-supply = <&vdd_buck1>;
};

&cpu5 {
	cpu-supply = <&vdd_buck1>;
};

&cpu6 {
	cpu-supply = <&vdd_buck1>;
};

&cpu7 {
	cpu-supply = <&vdd_buck1>;
};

&decon {
	memory-region = <&cont_splash_mem>;

	/* Tearing effect input from the command mode panel */
	pinctrl-0 = <&decon_te_on>;
	pinctrl-names = "default";

	status = "okay";
};

&dsi {
	#address-cells = <1>;
	#size-cells = <0>;

	samsung,burst-clock-frequency = <490000000>;
	samsung,esc-clock-frequency = <16000000>;
	samsung,pll-clock-frequency = <26000000>;

	status = "okay";

	panel@0 {
		compatible = "samsung,s6e3aa2-ams474mm01";
		reg = <0>;

		vdd-supply = <&vdd_ldo30>;
		vci-supply = <&vdd_ldo29>;

		reset-gpios = <&gpd3 4 GPIO_ACTIVE_LOW>;
	};
};

&gpu {
	mali-supply = <&vdd_buck2>;

	status = "okay";
};

&hsi2c0 {
	status = "okay";

	pmic@66 {
		compatible = "samsung,s2mpu05-pmic";
		reg = <0x66>;

		interrupt-parent = <&gpa0>;
		interrupts = <2 IRQ_TYPE_LEVEL_LOW>;

		pinctrl-0 = <&pmic_irq>;
		pinctrl-names = "default";

		regulators {
			vdd_buck1: buck1 {
				regulator-name = "vdd_buck1";
				regulator-min-microvolt = <500000>;
				regulator-max-microvolt = <1300000>;
				regulator-ramp-delay = <12000>;
				regulator-boot-on;
				regulator-always-on;
			};

			vdd_buck2: buck2 {
				regulator-name = "vdd_buck2";
				/*
				 * Also supplies MIF, INT, DISP and CAM, which
				 * have no consumer: keep the bootloader's level.
				 */
				regulator-min-microvolt = <750000>;
				regulator-max-microvolt = <1300000>;
				regulator-ramp-delay = <12000>;
				regulator-boot-on;
				regulator-always-on;
			};

			vdd_buck3: buck3 {
				regulator-name = "vdd_buck3";
				regulator-min-microvolt = <500000>;
				regulator-max-microvolt = <1300000>;
				regulator-ramp-delay = <12000>;
				regulator-boot-on;
				regulator-always-on;
			};

			vdd_buck4: buck4 {
				regulator-name = "vdd_buck4";
				regulator-min-microvolt = <1200000>;
				regulator-max-microvolt = <1500000>;
				regulator-ramp-delay = <12000>;
				regulator-boot-on;
				regulator-always-on;
			};

			vdd_buck5: buck5 {
				regulator-name = "vdd_buck5";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <2100000>;
				regulator-ramp-delay = <12000>;
				regulator-boot-on;
				regulator-always-on;
			};

			vdd_ldo1: ldo1 {
				regulator-name = "vdd_ldo1";
				regulator-min-microvolt = <650000>;
				regulator-max-microvolt = <1350000>;
				regulator-ramp-delay = <12000>;
				regulator-boot-on;
				regulator-always-on;
			};

			vdd_ldo2: ldo2 {
				regulator-name = "vdd_ldo2";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <2800000>;
				regulator-ramp-delay = <12000>;
			};

			vdd_ldo3: ldo3 {
				regulator-name = "vdd_ldo3";
				regulator-min-microvolt = <800000>;
				regulator-max-microvolt = <2375000>;
				regulator-ramp-delay = <12000>;
				regulator-boot-on;
				regulator-always-on;
			};

			vdd_ldo4: ldo4 {
				regulator-name = "vdd_ldo4";
				regulator-min-microvolt = <800000>;
				regulator-max-microvolt = <1350000>;
				regulator-ramp-delay = <12000>;
				regulator-boot-on;
				regulator-always-on;
			};

			vdd_ldo5: ldo5 {
				regulator-name = "vdd_ldo5";
				regulator-min-microvolt = <800000>;
				regulator-max-microvolt = <1350000>;
				regulator-ramp-delay = <12000>;
				regulator-boot-on;
				regulator-always-on;
			};

			vdd_ldo6: ldo6 {
				regulator-name = "vdd_ldo6";
				regulator-min-microvolt = <800000>;
				regulator-max-microvolt = <1350000>;
				regulator-ramp-delay = <12000>;
				regulator-boot-on;
				regulator-always-on;
			};

			vdd_ldo7: ldo7 {
				regulator-name = "vdd_ldo7";
				regulator-min-microvolt = <800000>;
				regulator-max-microvolt = <2375000>;
				regulator-ramp-delay = <12000>;
				regulator-boot-on;
				regulator-always-on;
			};

			vdd_ldo8: ldo8 {
				regulator-name = "vdd_ldo8";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <3375000>;
				regulator-ramp-delay = <12000>;
			};

			vdd_ldo9: ldo9 {
				regulator-name = "vdd_ldo9";
				regulator-min-microvolt = <650000>;
				regulator-max-microvolt = <1350000>;
				regulator-ramp-delay = <12000>;
				regulator-boot-on;
				regulator-always-on;
			};

			vdd_ldo10: ldo10 {
				regulator-name = "vdd_ldo10";
				regulator-min-microvolt = <650000>;
				regulator-max-microvolt = <1350000>;
				regulator-ramp-delay = <12000>;
				regulator-boot-on;
				regulator-always-on;
			};

			vdd_ldo25: ldo25 {
				regulator-name = "vdd_ldo25";
				regulator-min-microvolt = <800000>;
				regulator-max-microvolt = <2375000>;
				regulator-ramp-delay = <12000>;
				regulator-boot-on;
				regulator-always-on;
			};

			/* eMMC core */
			vdd_ldo26: ldo26 {
				regulator-name = "vdd_ldo26";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <3375000>;
				regulator-ramp-delay = <12000>;
				regulator-boot-on;
				regulator-always-on;
			};

			/* eMMC I/O */
			vdd_ldo27: ldo27 {
				regulator-name = "vdd_ldo27";
				regulator-min-microvolt = <800000>;
				regulator-max-microvolt = <2375000>;
				regulator-ramp-delay = <12000>;
				regulator-boot-on;
				regulator-always-on;
			};

			/* Panel analog supply (LCD_3P0) */
			vdd_ldo29: ldo29 {
				regulator-name = "vdd_ldo29";
				regulator-min-microvolt = <3000000>;
				regulator-max-microvolt = <3000000>;
				regulator-boot-on;
			};

			/* Panel I/O supply (LCD_1P8) */
			vdd_ldo30: ldo30 {
				regulator-name = "vdd_ldo30";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-boot-on;
			};

			/* 2.95 V on A3 (2.8 V on J5) */
			vdd_ldo31: ldo31 {
				regulator-name = "vdd_ldo31";
				regulator-min-microvolt = <2950000>;
				regulator-max-microvolt = <2950000>;
				regulator-ramp-delay = <12000>;
				regulator-boot-on;
				regulator-always-on;
			};

			/* Vibrator motor */
			vdd_ldo32: ldo32 {
				regulator-name = "vdd_ldo32";
				regulator-min-microvolt = <3325000>;
				regulator-max-microvolt = <3325000>;
				regulator-ramp-delay = <12000>;
			};

			/* Touch key controller AVDD and key LEDs 3.3 V */
			vdd_ldo33: ldo33 {
				regulator-name = "vdd_ldo33";
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-ramp-delay = <12000>;
			};

			/* Touchscreen AVDD */
			vdd_ldo34: ldo34 {
				regulator-name = "vdd_ldo34";
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
			};

			/*
			 * Camera sensor analog 2.95 V. Unlike J5 (3.3 V,
			 * always-on) this must not exceed 2.95 V.
			 */
			vdd_ldo35: ldo35 {
				regulator-name = "vdd_ldo35";
				regulator-min-microvolt = <2950000>;
				regulator-max-microvolt = <2950000>;
			};
		};
	};
};

&i2c0 {
	samsung,i2c-sda-delay = <100>;
	samsung,i2c-max-bus-freq = <400000>;

	status = "okay";

	fuel-gauge@3b {
		compatible = "samsung,s2mu004-fuel-gauge", "samsung,s2mu005-fuel-gauge";
		reg = <0x3b>;
		interrupt-parent = <&gpa0>;
		interrupts = <3 IRQ_TYPE_EDGE_FALLING>;

		pinctrl-0 = <&fuel_irq>;
		pinctrl-names = "default";
	};
};

&i2c4 {
	samsung,i2c-sda-delay = <100>;
	samsung,i2c-max-bus-freq = <400000>;

	status = "okay";

	pmic@3d {
		compatible = "samsung,s2mu004-pmic";
		reg = <0x3d>;
		interrupt-parent = <&gpa2>;
		interrupts = <7 IRQ_TYPE_LEVEL_LOW>;

		io-channels = <&battery_thermistor>;
		io-channel-names = "batt-temp";
		monitored-battery = <&battery>;

		pinctrl-0 = <&if_pmic_irq>;
		pinctrl-names = "default";

		wakeup-source;

		muic {
			compatible = "samsung,s2mu004-muic";
		};
	};
};

&i2c6 {
	samsung,i2c-sda-delay = <100>;
	samsung,i2c-max-bus-freq = <400000>;

	status = "okay";

	touchscreen@50 {
		compatible = "imagis,ist3038h";
		reg = <0x50>;

		interrupt-parent = <&gpa0>;
		interrupts = <6 IRQ_TYPE_EDGE_FALLING>;

		pinctrl-0 = <&touch_irq>;
		pinctrl-names = "default";

		touchscreen-size-x = <720>;
		touchscreen-size-y = <1280>;

		vdd-supply = <&vdd_ldo34>;
		vddio-supply = <&vdd_fixed_touch>;
	};
};

&mmc0 {
	pinctrl-0 = <&sd0_clk &sd0_cmd &sd0_rdqs &sd0_bus1 &sd0_bus4 &sd0_bus8>;
	pinctrl-names = "default";

	vmmc-supply = <&vdd_ldo26>;
	vqmmc-supply = <&vdd_ldo27>;

	fifo-depth = <64>;
	non-removable;

	samsung,dw-mshc-ciu-div = <3>;
	samsung,dw-mshc-sdr-timing = <0 4>;
	samsung,dw-mshc-ddr-timing = <2 4>;

	status = "okay";
};

/* QCA9377 Wi-Fi (SDIO) */
&mmc1 {
	#address-cells = <1>;
	#size-cells = <0>;

	pinctrl-0 = <&sd1_clk &sd1_cmd &sd1_bus1 &sd1_bus4 &wlan_enable>;
	pinctrl-names = "default";

	mmc-pwrseq = <&pwrseq_mmc1>;

	bus-width = <4>;
	fifo-depth = <64>;
	non-removable;
	cap-sd-highspeed;
	cap-sdio-irq;
	keep-power-in-suspend;

	samsung,dw-mshc-ciu-div = <3>;
	samsung,dw-mshc-sdr-timing = <0 3>;
	samsung,dw-mshc-ddr-timing = <1 2>;

	status = "okay";

	wifi@1 {
		compatible = "qcom,ath10k";
		reg = <1>;
	};
};

/* microSD slot (hybrid SIM2/SD tray) */
&mmc2 {
	pinctrl-0 = <&sd2_clk &sd2_cmd &sd2_bus1 &sd2_bus4 &dwmmc2_irq>;
	pinctrl-names = "default";

	vmmc-supply = <&vdd_fixed_mmc2>;
	vqmmc-supply = <&vdd_ldo2>;

	bus-width = <4>;
	card-detect-delay = <200>;
	cd-gpios = <&gpa0 1 GPIO_ACTIVE_LOW>;
	fifo-depth = <64>;
	cap-sd-highspeed;
	sd-uhs-sdr50;
	sd-uhs-sdr104;
	disable-wp;

	samsung,dw-mshc-ciu-div = <3>;
	samsung,dw-mshc-sdr-timing = <0 3>;
	samsung,dw-mshc-ddr-timing = <1 2>;

	status = "okay";
};

&oscclk {
	clock-frequency = <26000000>;
};

&pinctrl_alive {
	dwmmc2_irq: dwmmc2-irq-pins {
		samsung,pins = "gpa0-1";
		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
		samsung,pin-drv = <EXYNOS5433_PIN_DRV_FAST_SR1>;
	};

	key_power: key-power-pins {
		samsung,pins = "gpa0-0";
		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
		samsung,pin-drv = <EXYNOS5433_PIN_DRV_FAST_SR1>;
	};

	key_voldown: key-voldown-pins {
		samsung,pins = "gpa2-1";
		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
		samsung,pin-drv = <EXYNOS5433_PIN_DRV_FAST_SR1>;
	};

	key_volup: key-volup-pins {
		samsung,pins = "gpa2-0";
		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
		samsung,pin-drv = <EXYNOS5433_PIN_DRV_FAST_SR1>;
	};

	fuel_irq: fuel-irq-pins {
		samsung,pins = "gpa0-3";
		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
		samsung,pin-drv = <EXYNOS5433_PIN_DRV_FAST_SR1>;
	};

	hall_irq: hall-irq-pins {
		samsung,pins = "gpa2-3";
		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
		samsung,pin-drv = <EXYNOS5433_PIN_DRV_FAST_SR1>;
	};

	if_pmic_irq: if-pmic-irq-pins {
		samsung,pins = "gpa2-7";
		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
		samsung,pin-drv = <EXYNOS5433_PIN_DRV_FAST_SR1>;
	};

	pmic_irq: pmic-irq-pins {
		samsung,pins = "gpa0-2";
		samsung,pin-pud = <EXYNOS_PIN_PULL_UP>;
		samsung,pin-drv = <EXYNOS5433_PIN_DRV_FAST_SR4>;
	};

	touchkey_irq: touchkey-irq-pins {
		samsung,pins = "gpa1-4";
		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_UP>;
		samsung,pin-drv = <EXYNOS5433_PIN_DRV_FAST_SR1>;
	};

	touch_irq: touch-irq-pins {
		samsung,pins = "gpa0-6";
		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
		samsung,pin-drv = <EXYNOS5433_PIN_DRV_FAST_SR1>;
	};
};

&pinctrl_top {
	bt_enable: bt-enable-pins {
		samsung,pins = "gpd4-0";
		samsung,pin-function = <EXYNOS_PIN_FUNC_OUTPUT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_DOWN>;
		samsung,pin-con-pdn = <EXYNOS_PIN_PDN_PREV>;
		samsung,pin-pud-pdn = <EXYNOS_PIN_PULL_NONE>;
	};

	wlan_enable: wlan-enable-pins {
		samsung,pins = "gpd3-6";
		samsung,pin-function = <EXYNOS_PIN_FUNC_OUTPUT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
		samsung,pin-drv = <EXYNOS5433_PIN_DRV_FAST_SR4>;
		samsung,pin-con-pdn = <EXYNOS_PIN_PDN_PREV>;
		samsung,pin-pud-pdn = <EXYNOS_PIN_PULL_NONE>;
		samsung,pin-val = <0>;
	};
};

/*
 * Reserved for the secure world (eSE SPI on gpc7, secure touch I2C on gpc3):
 * any non-secure register access takes a synchronous external abort.
 */
&pinctrl_ese {
	status = "disabled";
};

&pinctrl_touch {
	status = "disabled";
};

/* QCA9377 Bluetooth */
&serial1 {
	status = "okay";

	bluetooth {
		compatible = "qcom,qca9377-bt";
		pinctrl-0 = <&bt_enable>;
		pinctrl-names = "default";

		clocks = <&bt_sleep_clk>;
		enable-gpios = <&gpd4 0 GPIO_ACTIVE_HIGH>;
		max-speed = <3000000>;
	};
};

&serial2 {
	status = "okay";
};

&usbdrd {
	vdd33-supply = <&vdd_ldo8>;

	status = "okay";

	/* No USB-C (S2MU004) driver yet: stay in gadget mode for USB networking */
	usb@0 {
		role-switch-default-mode = "peripheral";
	};
};
